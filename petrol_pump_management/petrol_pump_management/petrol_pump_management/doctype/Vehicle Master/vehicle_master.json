{
  "name": "Vehicle Master",
  "module": "Petrol Pump Management",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "custom": 0,
  "is_submittable": 0,
  "autoname": "field:vehicle_number",
  "title_field": "vehicle_number",
  "search_fields": "vehicle_number,customer",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "allow_rename": 0,
  "is_tree": 0,
  "is_calendar_and_gantt": 0,
  "editable_grid": 0,
  "max_attachments": 0,
  "fields": [
    {
      "fieldname": "vehicle_number",
      "fieldtype": "Data",
      "label": "Vehicle Number",
      "reqd": 1,
      "in_list_view": 1,
      "unique": 1
    },
    {
      "fieldname": "vehicle_type",
      "fieldtype": "Select",
      "label": "Vehicle Type",
      "options": "Two-wheeler\nCar\nCommercial\nTractor\nBus\nOther",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "label": "Credit Customer",
      "options": "PP Customer",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "fuel_type_preference",
      "fieldtype": "Select",
      "label": "Fuel Type Preference",
      "options": "Petrol\nDiesel\nPremium Petrol\nCNG\nLPG"
    },
    {
      "fieldname": "anpr_tag_status",
      "fieldtype": "Select",
      "label": "ANPR Tag Status",
      "options": "Active\nInactive\nUnder Review",
      "reqd": 1,
      "default": "Active"
    },
    {
      "fieldname": "registered_on",
      "fieldtype": "Date",
      "label": "Registered On",
      "reqd": 1,
      "default": "Today"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "Station Manager",
      "permlevel": 0,
      "read": 1,
