{
  "name": "Bank Deposit",
  "module": "Petrol Pump Management",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "custom": 0,
  "is_submittable": 1,
  "autoname": "",
  "title_field": "",
  "search_fields": "bank_name,deposit_date",
  "sort_field": "deposit_date",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "deposit_date",
      "fieldtype": "Date",
      "label": "Deposit Date",
      "reqd": 1,
      "in_list_view": 1,
      "default": "Today"
    },
    {
      "fieldname": "amount",
      "fieldtype": "Currency",
      "label": "Deposit Amount",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "bank_name",
      "fieldtype": "Data",
      "label": "Bank Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "deposit_slip_no",
      "fieldtype": "Data",
      "label": "Deposit Slip No"
    },
    {
      "fieldname": "account_number",
      "fieldtype": "Data",
      "label": "Account Number"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nDeposited\nConfirmed",
      "reqd": 1,
      "in_list_view": 1,
      "default": "Draft"
    }
  ],
  "permissions": [
    {
      "role": "Station Manager",
      "permlevel": 0,
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 0,
      "report": 0
    },
    {
      "role": "System Manager",
      "permlevel": 0,
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 1,
      "cancel": 0,
      "report": 0
    }
  ]
}