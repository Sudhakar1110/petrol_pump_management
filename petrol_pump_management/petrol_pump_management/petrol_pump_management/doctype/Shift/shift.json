{
  "name": "Shift",
  "module": "Petrol Pump Management",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "custom": 0,
  "is_submittable": 1,
  "autoname": "",
  "title_field": "",
  "search_fields": "shift_date,salesman",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "allow_rename": 0,
  "is_tree": 0,
  "is_calendar_and_gantt": 0,
  "editable_grid": 0,
  "max_attachments": 0,
  "fields": [
    {
      "fieldname": "shift_date",
      "fieldtype": "Date",
      "label": "Shift Date",
      "reqd": 1,
      "default": "Today",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "salesman",
      "fieldtype": "Link",
      "label": "Salesman",
      "options": "Employee Master",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Open\nClosed\nSettled",
      "reqd": 1,
      "default": "Open",
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "opening_cash",
      "fieldtype": "Currency",
      "label": "Opening Cash",
      "reqd": 1
    },
    {
      "fieldname": "closing_cash",
      "fieldtype": "Currency",
      "label": "Closing Cash"
    },
    {
      "fieldname": "section_break_nozzles",
      "fieldtype": "Section Break",
      "label": "Nozzle Allotment"
    },
    {
      "fieldname": "nozzles_allotted",
      "fieldtype": "Table",
      "label": "Nozzles Allotted",
      "options": "Shift Nozzle Allotment"
    },
    {
      "fieldname": "section_break_settlement",
      "fieldtype": "Section Break",
      "label": "Settlement",
      "depends_on": "eval:doc.docstatus==1"
    },
    {
      "fieldname": "total_sale_amount",
      "fieldtype": "Currency",
      "label": "Total Sale Amount",
      "read_only": 1
    },
    {
      "fieldname": "cash_collected",
      "fieldtype": "Currency",
      "label": "Cash Collected",
      "read_only": 1
    },
    {
      "fieldname": "card_upi_amount",
      "fieldtype": "Currency",
      "label": "Card/UPI Amount",
      "read_only": 1
    },
    {
      "fieldname": "credit_amount",
      "fieldtype": "Currency",
      "label": "Credit Amount",
      "read_only": 1
    },
    {
      "fieldname": "cash_shortage",
      "fieldtype": "Currency",
      "label": "Cash Shortage",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "Station Manager",
      "permlevel": 0,
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 0,
      "report": 1,
      "export": 0,
      "import": 0,
      "print": 0,
      "email": 0,
      "share": 0
    },
    {
      "role": "Salesman DSM",
      "permlevel": 0,
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "amend": 0,
      "report": 0,
      "export": 0,
      "import": 0,
      "print": 0,
      "email": 0,
      "share": 0
    }
  ]
}