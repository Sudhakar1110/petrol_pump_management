      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "employee_name",
      "fieldtype": "Data",
      "label": "Employee Name",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "attendance_date",
      "fieldtype": "Date",
      "label": "Date",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "default": "Today"
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Present\nAbsent\nHalf Day\nLeave\nHoliday",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "shift",
      "fieldtype": "Data",
      "label": "Shift",
      "in_list_view": 1
    },
    {
      "fieldname": "salary_type",
      "fieldtype": "Select",
      "label": "Salary Type",
      "options": "Paid\nUnpaid"
    },
    {
      "fieldname": "in_time",
      "fieldtype": "Time",
      "label": "In Time"
    },
    {
      "fieldname": "out_time",
      "fieldtype": "Time",
      "label": "Out Time"
    },
    {
      "fieldname": "note",
      "fieldtype": "Small Text",
      "label": "Note"
    }
