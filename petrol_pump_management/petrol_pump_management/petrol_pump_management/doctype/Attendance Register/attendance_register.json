{
  "name": "Attendance Register",
  "module": "Petrol Pump Management",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "custom": 0,
  "is_submittable": 0,
  "autoname": "",
  "title_field": "",
