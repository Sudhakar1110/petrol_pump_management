      "cancel": 0,
      "report": 0
    },
    {
      "role": "Salesman DSM",
      "permlevel": 0,
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "submit": 0,
      "cancel": 0,
      "report": 0
    }
  ]
}