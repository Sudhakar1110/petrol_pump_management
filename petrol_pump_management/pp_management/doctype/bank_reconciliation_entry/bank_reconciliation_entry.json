{
 "name": "Bank Reconciliation Entry",
 "module": "PP Management",
 "doctype": "DocType",
 "document_type": "Document",
 "engine": "InnoDB",
 "custom": 0,
 "autoname": "naming_series:",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Naming Series", "options": "BANK RECON", "reqd": 1, "default": "BANK RECON", "set_only_once": 1},
  {"fieldname": "reconciliation_date", "fieldtype": "Date", "label": "Reconciliation Date", "reqd": 1, "default": "Today"},
  {"fieldname": "bank_account", "fieldtype": "Data", "label": "Bank Account", "reqd": 1},
  {"fieldname": "statement_date", "fieldtype": "Date", "label": "Statement Date"},
  {"fieldname": "cb1", "fieldtype": "Column Break"},
  {"fieldname": "book_balance", "fieldtype": "Currency", "label": "Book Balance", "reqd": 1},
  {"fieldname": "bank_balance", "fieldtype": "Currency", "label": "Bank Statement Balance", "reqd": 1},
  {"fieldname": "difference", "fieldtype": "Currency", "label": "Difference", "read_only": 1},
  {"fieldname": "s_items", "fieldtype": "Section Break", "label": "Unreconciled Items"},
  {"fieldname": "deposit_amount", "fieldtype": "Currency", "label": "Deposits Not in Bank"},
  {"fieldname": "withdrawal_amount", "fieldtype": "Currency", "label": "Withdrawals Not in Bank"},
  {"fieldname": "bank_charges", "fieldtype": "Currency", "label": "Bank Charges Not in Book"},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nReconciled\nDisputed", "default": "Draft"},
  {"fieldname": "remarks", "fieldtype": "Small Text", "label": "Remarks"}
 ],
 "permissions": [
  {"role": "Station Manager", "permlevel": 0, "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "Credit Accounts Officer", "permlevel": 0, "read": 1, "write": 1, "create": 1, "delete": 0},
  {"role": "Petrol Pump Auditor", "permlevel": 0, "read": 1, "write": 0, "create": 0, "delete": 0}
 ],
 "naming_rule": "By \"Naming Series\" field"
}
