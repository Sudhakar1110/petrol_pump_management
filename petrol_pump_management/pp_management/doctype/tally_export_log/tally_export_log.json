{
 "name": "Tally Export Log",
 "module": "PP Management",
 "doctype": "DocType",
 "document_type": "Document",
 "engine": "InnoDB",
 "custom": 0,
 "autoname": "naming_series:",
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Naming Series", "options": "TALLY EXPORT", "reqd": 1, "default": "TALLY EXPORT", "set_only_once": 1},
  {"fieldname": "export_date", "fieldtype": "Date", "label": "Export Date", "reqd": 1, "default": "Today"},
  {"fieldname": "export_type", "fieldtype": "Select", "label": "Export Type", "options": "Sales\nPurchase\nExpense\nCredit\nJournal\nAll", "reqd": 1, "in_list_view": 1},
  {"fieldname": "period_from", "fieldtype": "Date", "label": "Period From", "reqd": 1},
  {"fieldname": "cb1", "fieldtype": "Column Break"},
  {"fieldname": "period_to", "fieldtype": "Date", "label": "Period To", "reqd": 1},
  {"fieldname": "records_exported", "fieldtype": "Int", "label": "Records Exported", "read_only": 1},
  {"fieldname": "export_status", "fieldtype": "Select", "label": "Status", "options": "Draft\nExported\nImported to Tally\nFailed", "default": "Draft"},
  {"fieldname": "export_file", "fieldtype": "Attach", "label": "Export File"},
  {"fieldname": "remarks", "fieldtype": "Small Text", "label": "Remarks"}
 ],
 "permissions": [
  {"role": "Station Manager", "permlevel": 0, "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "Credit Accounts Officer", "permlevel": 0, "read": 1, "write": 1, "create": 1, "delete": 0}
 ],
 "naming_rule": "By \"Naming Series\" field"
}
