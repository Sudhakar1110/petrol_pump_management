{
 "name": "Credit Statement",
 "module": "PP Management",
 "doctype": "DocType",
 "document_type": "Document",
 "engine": "InnoDB",
 "custom": 0,
 "autoname": "naming_series:",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "fields": [
  {"fieldname": "naming_series", "fieldtype": "Select", "label": "Naming Series", "options": "CREDIT STMT", "reqd": 1, "default": "CREDIT STMT", "set_only_once": 1},
  {"fieldname": "customer", "fieldtype": "Link", "label": "Customer", "options": "PP Customer", "reqd": 1, "in_list_view": 1},
  {"fieldname": "statement_date", "fieldtype": "Date", "label": "Statement Date", "reqd": 1, "default": "Today"},
  {"fieldname": "period_from", "fieldtype": "Date", "label": "Period From", "reqd": 1},
  {"fieldname": "cb1", "fieldtype": "Column Break"},
  {"fieldname": "period_to", "fieldtype": "Date", "label": "Period To", "reqd": 1},
  {"fieldname": "opening_balance", "fieldtype": "Currency", "label": "Opening Balance", "default": "0"},
  {"fieldname": "total_credit", "fieldtype": "Currency", "label": "Total Credit Sales", "default": "0"},
  {"fieldname": "total_payment", "fieldtype": "Currency", "label": "Total Payments", "default": "0"},
  {"fieldname": "interest_charged", "fieldtype": "Currency", "label": "Interest Charged", "default": "0"},
  {"fieldname": "s_details", "fieldtype": "Section Break", "label": "Summary"},
  {"fieldname": "closing_balance", "fieldtype": "Currency", "label": "Closing Balance", "read_only": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nSent\nPaid\nOverdue", "default": "Draft"},
  {"fieldname": "email_sent", "fieldtype": "Check", "label": "Email Sent", "default": 0},
  {"fieldname": "sms_sent", "fieldtype": "Check", "label": "SMS Sent", "default": 0},
  {"fieldname": "due_date", "fieldtype": "Date", "label": "Payment Due Date"}
 ],
 "permissions": [
  {"role": "Station Manager", "permlevel": 0, "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "Credit Accounts Officer", "permlevel": 0, "read": 1, "write": 1, "create": 1, "delete": 0},
  {"role": "Recovery Officer", "permlevel": 0, "read": 1, "write": 1, "create": 0, "delete": 0}
 ],
 "naming_rule": "By \"Naming Series\" field"
}
