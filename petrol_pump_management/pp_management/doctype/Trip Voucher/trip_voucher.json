{
  "name": "Trip Voucher",
  "module": "PP Management",
  "doctype": "DocType",
  "document_type": "Document",
  "engine": "InnoDB",
  "custom": 0,
  "is_submittable": 1,
  "autoname": "",
  "title_field": "",
  "search_fields": "",
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "trip_no",
      "fieldtype": "Data",
      "label": "Trip Number",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "supplier",
      "fieldtype": "Link",
      "label": "Supplier",
      "options": "PP Supplier Master",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "tanker_no",
      "fieldtype": "Data",
      "label": "Tanker Number",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "fuel_type",
      "fieldtype": "Select",
      "label": "Fuel Type",
      "options": "Petrol\nDiesel\nPremium Petrol\nCNG\nLPG",
      "reqd": 1
    },
    {
      "fieldname": "cb1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "invoiced_qty",
      "fieldtype": "Currency",
      "label": "Invoiced Qty (Litres)",
      "reqd": 1
    },
    {
      "fieldname": "received_qty",
      "fieldtype": "Currency",
      "label": "Received Qty (Litres)"
    },
    {
      "fieldname": "trip_date",
      "fieldtype": "Date",
      "label": "Trip Date",
      "reqd": 1,
      "default": "Today"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "In Transit\nReceived\nDecanted",
      "default": "In Transit",
      "reqd": 1
    }
  ],
  "permissions": [
    {
      "role": "Station Manager",
      "permlevel": 0,
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ]
}